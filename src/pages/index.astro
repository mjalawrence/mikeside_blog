---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <!-- <ImageCarousel images={images} gallery="rod-curb" /> -->

    <!-- <Lightbox /> -->
    <div class="home_body">
      <div class="home-text">
        <div class="home-introduction">
          <!-- <h1 class="intro-title">Welcome</h1> -->
          <div class="intro-sentence">Mikeside is a DIY skate park in Neepsend, Sheffield.</div>
          <div class="intro-sentence">It is a community project using reclaimed materials and funded by donations.</div>
          <div class="intro-sentence">Started 16th August 2025.</div>
        </div>

        <div class="entry_item_list">
          <p class="entry_header">Blog</p>
          <div class="blog-container">
            <p>Learn more about what went into building it:</p>

            Sort by:
            <select id="sort-select" class="custom-select">
              <option id="buildSort" value="buildDate" selected>Timeline</option>
              <option id="pubSort" value="pubDate">Published Recently</option>
            </select>
            <ol id="post-list">
              {
                posts.map((post) => (
                  <li class="entry_point" data-pubdate={post.data.pubDate.valueOf()} data-builddate={post.data.buildDate.valueOf()}>
                    <a class="entry_item" href={`/blog/${post.id}/`}>
                      {post.data.title}
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>

      <div class="home-image-container">
        <ImageCarousel images={images} gallery="rod-curb" />
        <!-- <img class="home_image" src="../../public/images/home/the_wall.PNG" /> -->
      </div>
    </div>
    <script type="module" src="../../public/scripts/post-sort.js"></script>
  </body>
</html>
