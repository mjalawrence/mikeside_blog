<style>
  /* .div-container {
    display: flex;
    justify-content: center;
    max-width: 1000px;
  }

  .slide {
    display: none;
  }

  .image {
    width: 300px;
  } */

  *,
  *::after,
  *::before {
    border: 0;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --slide-progress: 35%;
    --slide-progress--transition: all 200ms cubic-bezier(0.82, 0.02, 0.39, 1.01);
  }

  .container {
    display: grid;
    place-items: center;
    align-content: center;
    /* min-height: 100vh; */
    /* padding: 2rem 0; */
  }

  h1 {
    font-size: 3rem;
    line-height: 1.4;
    margin-bottom: 0.5em;
    color: hsla(210, 50%, 20%, 1);
    position: relative;
    z-index: 5;
  }

  .slider {
    position: relative;
    display: grid;
    place-items: center;
    /* max-width: 800px; */
    overflow: hidden;
  }

  .slide {
    /* height: 400px; */
    max-height: 100vh;
    display: flex;
  }

  .slide img {
    width: 100%;
    flex: 1 0 100%;
    object-fit: cover;
  }

  .slider__progress {
    position: absolute;
    width: 100%;
    height: 6px;
    background: linear-gradient(90deg, hsla(210, 50%, 90%, 0.2), hsla(210, 50%, 70%, 0.1));
    bottom: 0;
    z-index: 4;
  }

  .slider__progress::after {
    content: "";
    position: absolute;
    background: linear-gradient(90deg, hsla(210, 50%, 90%, 0.7), hsla(210, 50%, 70%, 0.6));
    width: var(--slide-progress);
    height: 6px;
    left: 0;
    transition: var(--slide-progress--transition);
  }

  .slider__btn-container {
    position: absolute;
    width: 100%;
  }

  .slider__btn {
    border-radius: 50%;
    position: absolute;
    z-index: 2;
    padding: 0.2rem;
    top: 50%;
    display: grid;
    place-items: center;
    cursor: pointer;
    background: hsla(210, 50%, 30%, 0.15);
    color: hsla(210, 50%, 95%, 0.9);
  }

  .slider__btn svg {
    pointer-events: none;
  }

  .slider__btn--left {
    left: 0;
    transform: translate(50%, -50%);
  }
  .slider__btn--left:is(:hover, :focus) {
    animation: 850ms infinite moveLeft cubic-bezier(0.25, -0.5, 0.17, 1.2);
  }

  @keyframes moveLeft {
    10% {
      left: -3px;
    }
  }

  .slider__btn--right {
    right: 0;
    transform: translate(-50%, -50%);
  }
  .slider__btn--right:is(:hover, :focus) {
    animation: 850ms infinite moveRight cubic-bezier(0.25, -0.5, 0.17, 1.2);
  }

  @keyframes moveRight {
    10% {
      right: -3px;
    }
  }
</style>
