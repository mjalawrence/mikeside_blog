  let slideIndex = 1;
  let isMoving = false;

  function moveSlides() {
    slide.style.transform = `translateX(-${slideIndex * 100}%)`;

    const slidesArray = [...slide.querySelectorAll("img")];

    root.style.setProperty(
      "--slide-progress",
      `${(100 / (slidesArray.length - 3)) * (slideIndex - 1)}%`
    );
  }

// Set initial position to the first real image
moveSlides();
