---
// src/components/Lightbox.astro
---

<div id="lightbox" hidden>
  <button id="prev">←</button>
    <div id="lightbox-img-container">
      <img id="lightbox-image">
    </div>
  <button id="next">→</button>
</div>

<script>

  const lightbox = document.getElementById("lightbox");
  const lightboxImage = document.getElementById("lightbox-image");
  const lightboxImgCont = document.getElementById("lightbox-img-container");
  const prevBtn = document.getElementById("prev");
  const nextBtn = document.getElementById("next");

  let currentGallery = [];
  let currentIndex = 0;

  function showImage(index: number) {
    const img = currentGallery[index];

    // lightboxImage.src = img.dataset.lightboxSrc || img.src;
    lightboxImage.src = img.src;
    lightboxImage.alt = img.alt;

    currentIndex = index;
  }

  function openLightbox(clickedImg) {
    const gallery = clickedImg.dataset.gallery;

    if (gallery) {
      prevBtn.hidden = false;
      nextBtn.hidden = false;
      currentGallery = Array.from(
        document.querySelectorAll(
          `.zoomable[data-gallery="${gallery}"]`
        )
      );
    } else {
      prevBtn.hidden = true;
      nextBtn.hidden = true;
      currentGallery = [clickedImg];
    }

    currentIndex = currentGallery.indexOf(clickedImg);
    showImage(currentIndex);

    lightbox.hidden = false;
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox.hidden = true;
    lightboxImage.src = "";
    lightboxImage.alt = "";
    document.body.style.overflow = "";

    currentGallery = [];
    currentIndex = 0;
  }

  function nextImage() {
    if (currentGallery.length <= 1) return;

    currentIndex = (currentIndex + 1) % currentGallery.length;
    
    showImage(currentIndex);
  }

  function previousImage() {
    if (currentGallery.length <= 1) return;

    currentIndex =
      (currentIndex - 1 + currentGallery.length) %
      currentGallery.length;

    showImage(currentIndex);
  }

  // Click on an .zoomable image to open lightbox
  document.addEventListener("click", (e) => {
    const img = e.target.closest(".zoomable");
    if (!img) return;

    openLightbox(img);
  });

  // Close lightbox
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox || e.target === lightboxImgCont || e.target === lightboxImage) {
      closeLightbox();
    }
  });

  // Click the prev/next buttons to navigate
  prevBtn.addEventListener("click", (e) => {
        previousImage();
  });

  nextBtn.addEventListener("click", (e) => {
        nextImage();
  });

  // Navigate with keyboard
  document.addEventListener("keydown", (e) => {
    if (lightbox.hidden) return;

    switch (e.key) {
      case "Escape":
        closeLightbox();
        break;

      case "ArrowRight":
        nextImage();
        break;

      case "ArrowLeft":
        previousImage();
        break;
    }
  });
  
</script>