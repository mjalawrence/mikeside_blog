---
import ImageLightbox from "./ImageLightBox.astro";

interface ImageItem {
  src: string;
  alt?: string;
}

interface Props {
  images: ImageItem[];
  gallery?: string;
}

const { images, gallery = "carousel" } = Astro.props;
---

<main>
  <div class="slider">
    <div class="slider__progress"></div>
    <div class="slider__btn-container">
      <button class="slider__btn slider__btn--left"><div>←</div></button>
      <button class="slider__btn slider__btn--right"><div>→</div></button>
    </div>
    <div class="slide">
      {
        [images[images.length - 1], ...images, images[0]].map((image) => (
          <div>
          </div>
            <img src={image.src} alt={image.alt ?? ""} />
        ))
      }
    </div>

  </div>
  
</main>

<script type="module" src="../../public/scripts/carousel.js"></script>
